# MongoDB connection settings
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=scientific_calculator

# Backend port (change if 8000 is already in use)
PORT=8001

# ── AI Voice Agent ──────────────────────────────────────────────────────────
# Optional: set your OpenAI API key to enable AI-powered NLP for voice commands.
# Leave blank to use the built-in local rule-based parser (no key required).
AI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini — fast and cheap)
AI_MODEL=gpt-4o-mini

# Optional: override the API base URL (e.g. for Azure OpenAI or local LLMs)
# AI_API_BASE_URL=https://api.openai.com/v1

# Optional: comma-separated extra allowed CORS origins
# EXTRA_CORS_ORIGINS=https://myapp.example.com
